# =============================================================================
# .env.example — Developer-specific path configuration for docker-compose.yml
#
# Copy this file to .env.<yourname> (e.g. .env.aaron, .env.claude)
# and adjust paths for your machine.
# These files are gitignored — each developer maintains their own copy.
#
# Usage — always pass --env-file so docker compose knows which config to use:
#
#   docker compose --env-file .env.aaron --profile unit-django run --rm unit-django-runner
#   docker compose --env-file .env.claude --profile integration run --rm integration-runner
#   docker compose --env-file .env.claude --profile e2e run --rm e2e-runner
#
# =============================================================================

# --- Absolute paths to project directories ---
# Windows (native docker compose): use forward slashes (C:/Users/...)
# Linux/WSL (native docker/podman):  use standard paths (/home/... or /app/...)

# Path to koalixcrm repository
KOALIXCRM_DIR=../koalixcrm

# Path to the DB directory. The stack mounts ${KOALIXCRM_DB_DIR}/db -> /db
# (holding db.sqlite3 + integration.sqlite3). Point this at the registry-managed
# data tree so the live DB is backed up by the git-mcp sweep, e.g.
#   .../koalixcrm/local-dev/live   (→ files live in .../local-dev/live/db/)
KOALIXCRM_DB_DIR=../koalixcrm_data

# Path to the MinIO data dir, bind-mounted into the minio container at /data
# (registry: minio_bucket koalixcrm-pdf-exports). Point at the managed tree:
#   .../koalixcrm-system/local-dev/live/minio
KOALIXCRM_MINIO_DIR=../koalixcrm_data/minio

# Path to the directory containing secrets.env (copy docker/secrets.env.example
# there and fill in real secrets). Keep this OUTSIDE the backed-up data tree and
# out of any LLM agent's reach (the MCP-private repo-configs tree) — secrets must
# not be backed up nor agent-visible. Defaults to KOALIXCRM_DB_DIR for native
# setups where that separation is not needed.
KOALIXCRM_ENV_DIR=../koalixcrm_data

# Path to this system repository (where this file lives)
KOALIXCRM_SYSTEM_DIR=.

# Path to koalixcrm-fop-service repository (Java PDF service sources).
# Only used by the unit-pdf-service / integration-pdf-service profiles, which
# bind-mount the sources into a Gradle runner. The `pdf-service` runtime in
# the integration/e2e/dev profiles uses the published image and does not need
# this path.
KOALIXCRM_FOP_DIR=../koalixcrm-fop-service

# Container image tag for the pdf-service. Pin to a concrete version (e.g.
# `v2.0.0` or `sha-abc1234`) in production-like setups. Default `develop`
# tracks the head of the develop branch in koalixcrm-fop-service.
PDF_SERVICE_IMAGE_TAG=develop

# -----------------------------------------------------------------------------
# OPTIONAL: daemon-side overrides
# -----------------------------------------------------------------------------
# Set these ONLY if your shell and Docker daemon see different filesystem paths.
# Typical case: WSL shell talking to Docker Desktop on Windows — the WSL shell
# sees /app/... while the Windows docker daemon only sees C:/Users/...
#
# On native Windows/macOS/Linux, leave these commented out — the *_DIR values
# above are used for both parse-time and runtime.
#
# These MUST be the path the docker daemon sees for each repo — i.e. the host
# directory that the agent's /app is bind-mounted FROM. Code repos come from the
# repos tree; DB/MinIO come from the repo-DATA tree (so the git-mcp backup sweep
# captures them). secrets.env (KOALIXCRM_ENV_DIR) stays in the MCP-private
# repo-configs tree and so has no *_HOST_DIR override.
#
# *** docker-mcp (committed .env.claude): DO NOT hardcode absolute paths. ***
# .env.claude is committed + integrity-gated, so it must be machine-agnostic.
# It expresses host dirs as ${HOST_REPOS_ROOT}/... and ${HOST_DATA_ROOT}/..., and
# the two roots are provided per-machine by the docker-mcp container's OWN
# agent-invisible env file (~/repo-configs/<org>/docker-mcp/.env):
#   HOST_REPOS_ROOT=//c/Users/<you>/repos
#   HOST_DATA_ROOT=//c/Users/<you>/repo-data
# (find them with: grep ' /app ' /proc/self/mountinfo → source before "/app").
# Compose interpolates them from that environment. This keeps usernames out of
# git while the gated suffixes stay fixed.
#
# *** Native developers (your own gitignored .env.<name>): *** set absolute
# paths directly below for YOUR machine (these files are never committed and the
# docker-mcp never uses them). On native Windows/macOS/Linux you usually don't
# need *_HOST_DIR at all — the *_DIR values serve both parse-time and runtime.
# Example (WSL + Docker Desktop, repos under C:\Users\you\repos, data under
# C:\Users\you\repo-data):
#   KOALIXCRM_HOST_DIR=//c/Users/you/repos/koalixswitzerland/products/koalixcrm
#   KOALIXCRM_DB_HOST_DIR=//c/Users/you/repo-data/koalixswitzerland/products/koalixcrm/local-dev/live
#   KOALIXCRM_MINIO_HOST_DIR=//c/Users/you/repo-data/koalixswitzerland/products/koalixcrm-system/local-dev/live/minio
# (⚠ NOT the old //c/Users/<you>/PycharmProjects/<repo> layout — that path no
#  longer exists and the runner mounts an empty /src.)

# KOALIXCRM_HOST_DIR=
# KOALIXCRM_DB_HOST_DIR=
# KOALIXCRM_MINIO_HOST_DIR=
# KOALIXCRM_SYSTEM_HOST_DIR=
# KOALIXCRM_FOP_HOST_DIR=

# --- Django auto-reload ---
# Set to 1 to enable Django's StatReloader for live code reloading (dev profile).
# Default is 0 (--noreload) which prevents spurious restarts on volume-mounted
# filesystems (WSL2, Docker Desktop). Only useful with the dev profile.
# DJANGO_AUTORELOAD=1

# --- UI language (Django LANGUAGE_CODE) ---
# Ships with: en-us (default), de, fr, es, pt-br.
# KOALIXCRM_LANGUAGE_CODE=de

# --- Optional port overrides ---
# DJANGO_PORT=8000
# MINIO_API_PORT=9010
# MINIO_CONSOLE_PORT=9011
# ELASTICMQ_PORT=9324
# ELASTICMQ_UI_PORT=9325
# NGINX_PORT=5000
# ALLURE_PORT=5001
