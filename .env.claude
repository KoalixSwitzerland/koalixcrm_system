# Env file for running the KoalixCRM stack via the docker MCP (cc-docker-mcp-klx).
#
# COMMITTED + integrity-gated (must match origin/main|develop), therefore
# MACHINE-AGNOSTIC: it contains NO absolute user paths. The only per-machine
# values are the two host roots, which are supplied by the docker-mcp
# container's OWN agent-invisible env file
# (~/repo-configs/koalixswitzerland/docker-mcp/.env):
#
#     HOST_REPOS_ROOT=//c/Users/<you>/repos
#     HOST_DATA_ROOT=//c/Users/<you>/repo-data
#
# Docker Compose interpolates ${HOST_REPOS_ROOT} / ${HOST_DATA_ROOT} below from
# that environment. Because the suffixes here are fixed (and gated) and the
# roots live in a file the agent cannot read or write, an agent can neither
# change the mount structure nor redirect the root — no arbitrary host mount.
#
# Secrets are NOT here — they live in repo-configs/secrets.env via KOALIXCRM_ENV_DIR.
#
# Two path families:
#   *_DIR       parse-time, inside the docker-mcp container (/app, /app-data,
#               /repo-configs) — already machine-agnostic.
#   *_HOST_DIR  bind-mount sources resolved by the host Docker daemon — built
#               from the per-machine ${HOST_*_ROOT} so no username is committed.

# --- Parse-time paths (inside cc-docker-mcp-klx) -----------------------------
KOALIXCRM_DIR=/app/products/koalixcrm
KOALIXCRM_SYSTEM_DIR=/app/products/koalixcrm-system
KOALIXCRM_FOP_DIR=/app/products/koalixcrm-fop-service
KOALIXCRM_DB_DIR=/app-data/products/koalixcrm/local-dev/live
KOALIXCRM_MINIO_DIR=/app-data/products/koalixcrm-system/local-dev/live/minio
KOALIXCRM_ENV_DIR=/repo-configs/products/koalixcrm-system

# --- Bind-mount sources (host daemon); roots from the docker-mcp env ---------
KOALIXCRM_HOST_DIR=${HOST_REPOS_ROOT}/koalixswitzerland/products/koalixcrm
KOALIXCRM_SYSTEM_HOST_DIR=${HOST_REPOS_ROOT}/koalixswitzerland/products/koalixcrm-system
KOALIXCRM_FOP_HOST_DIR=${HOST_REPOS_ROOT}/koalixswitzerland/products/koalixcrm-fop-service
KOALIXCRM_DB_HOST_DIR=${HOST_DATA_ROOT}/koalixswitzerland/products/koalixcrm/local-dev/live
KOALIXCRM_MINIO_HOST_DIR=${HOST_DATA_ROOT}/koalixswitzerland/products/koalixcrm-system/local-dev/live/minio

# Ports (chosen to avoid conflicts with WFS: 8000, 9020, 9021, 9324)
DJANGO_PORT=8010
MINIO_API_PORT=9030
MINIO_CONSOLE_PORT=9031
ELASTICMQ_PORT=9334
ELASTICMQ_UI_PORT=9335
ALLURE_PORT=5011
